OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
DATABASE_PATH=data/assistant.db
DEFAULT_TIMEZONE=Asia/Almaty
# Optional comma-separated Telegram user IDs. Empty means every user gets isolated storage.
ALLOWED_TELEGRAM_USER_IDS=
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Only for local browser development. Production must authenticate Telegram initData.
DEV_TELEGRAM_USER_ID=
